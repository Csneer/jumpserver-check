JMS_URL=https://jumpserver.example.com
JMS_ACCESS_KEY_ID=replace-with-access-key-id
JMS_ACCESS_KEY_SECRET=replace-with-access-key-secret
JMS_NO_PROXY=true
JMS_ORG_ID=00000000-0000-0000-0000-000000000002
JMS_VERIFY_TLS=true

# Yuque can point each profile to a different repo or directory.
YUQUE_TOKEN=replace-with-yuque-token
YUQUE_API_BASE=https://www.yuque.com/api/v2
YUQUE_REPO_NAMESPACE=your-login-or-group/your-repo
YUQUE_URL=
YUQUE_TARGET_TOC_UUID=
YUQUE_SIBLING_URL=
YUQUE_PUBLIC=0
YUQUE_FORMAT=markdown
YUQUE_USER_AGENT=jumpserver-check-yuque-sync/0.1

# Optional. If omitted, defaults include the profile name.
CHECK_YUQUE_TITLE=
CHECK_YUQUE_SLUG=
CHECK_NOTIFY_TITLE=

# Optional output overrides. If omitted, output is isolated by profile.
CHECK_OUTPUT_DIR=
CHECK_RAW_OUTPUT_DIR=
CHECK_WAIT_TIMEOUT=1200
CHECK_POLL_INTERVAL=30
CHECK_RETENTION_COUNT=12

# Optional notification.
WECOM_WEBHOOK_URL=
WECOM_CHANNEL=wecom_relay

# Optional cleanup confirmation UI / dangerous delete gate.
CLEANUP_ADMIN_TOKEN=
CLEANUP_ALLOW_DELETE=false
