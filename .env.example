JMS_URL=https://jumpserver.example.com
JMS_ACCESS_KEY_ID=replace-with-access-key-id
JMS_ACCESS_KEY_SECRET=replace-with-access-key-secret
JMS_NO_PROXY=true
JMS_ORG_ID=00000000-0000-0000-0000-000000000002
JMS_VERIFY_TLS=true

# Yuque report sync
YUQUE_TOKEN=replace-with-yuque-token
YUQUE_API_BASE=https://www.yuque.com/api/v2
YUQUE_REPO_NAMESPACE=your-login-or-group/your-repo
YUQUE_URL=
YUQUE_TARGET_TOC_UUID=
YUQUE_SIBLING_URL=
YUQUE_PUBLIC=0
YUQUE_FORMAT=markdown
YUQUE_USER_AGENT=jumpserver-check-yuque-sync/0.1

# WeCom notification
WECOM_WEBHOOK_URL=
WECOM_CHANNEL=wecom

# Weekly orchestration defaults
CHECK_WAIT_TIMEOUT=1200
CHECK_POLL_INTERVAL=30
CHECK_RAW_OUTPUT_DIR=artifacts/raw
CHECK_OUTPUT_DIR=reports/yuque
CHECK_RETENTION_COUNT=12
CHECK_YUQUE_TITLE=JumpServer 主机探测与 IP 配置检测报告
CHECK_YUQUE_SLUG=jumpserver-host-ip-check
CHECK_NOTIFY_TITLE=JumpServer 每周主机巡检

# Abandoned-host cleanup is disabled unless explicit CLI flags are used.
CLEANUP_ADMIN_TOKEN=
CLEANUP_ADMIN_PROFILE=local
CLEANUP_ADMIN_PROFILES=
CLEANUP_ADMIN_HOST=127.0.0.1
CLEANUP_ADMIN_PORT=8088
CLEANUP_ALLOW_DELETE=false
